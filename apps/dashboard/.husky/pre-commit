#!/usr/bin/env sh
# Phase 8.40: Pre-commit hook — run lint-staged on staged files (scoped to changes)
# Phase 8.44.2: 改 lint-staged (Phase 8.40 跑 pnpm lint:all 全量太慢, 改 staged-only)
# Phase 9.58 F49: backend pytest smoke opt-in (LINGWEN_PRECOMMIT_PYTEST=1|last-failed)
#   subset: tests/ci/ + 1 dashboard integration (~2s); 0 阻塞默认 commit
# Phase 10: 增强前端检查 - 添加类型检查和单元测试

# Frontend: explicit PATH setup (husky 4 shim broken)
export PATH="node_modules/.bin:$PATH"

# 前端检查步骤

echo "=== 前端预提交检查 ==="

# Step 1/5: staged-only lint via lint-staged
echo "Step 1/5: 运行 ESLint 检查..."
pnpm lint-staged
if [ $? -ne 0 ]; then
  echo "❌ ESLint 检查失败"
  exit 1
fi
echo "✅ ESLint 检查通过"

# Step 2/5: 类型检查 (仅检查 staged 文件相关的类型)
echo "Step 2/5: 运行类型检查..."
pnpm typecheck:app
if [ $? -ne 0 ]; then
  echo "❌ 类型检查失败"
  exit 1
fi
echo "✅ 类型检查通过"

# Step 3/5: 单元测试 (快速检查)
echo "Step 3/5: 运行单元测试..."
pnpm test
if [ $? -ne 0 ]; then
  echo "❌ 单元测试失败"
  exit 1
fi
echo "✅ 单元测试通过"

# Step 4/5: repo-wide file-size guard (Phase 16.8)
echo "Step 4/5: 运行文件尺寸 guard..."
cd "$(git rev-parse --show-toplevel)"
if ! python3 tooling/hygiene/check_file_size.py; then
  echo "❌ 文件尺寸检查失败：发现超出限制的文件"
  exit 1
fi
echo "✅ 文件尺寸检查通过"

# Step 5/5: brand consistency guard (Phase 16.9)
echo "Step 5/5: 运行品牌一致性检查..."
if ! python3 tooling/hygiene/check_brand_consistency.py; then
  echo "❌ 品牌一致性检查失败：发现违规的 LingWen / 墨灵 Studio / MoLing Studio 引用"
  exit 1
fi
echo "✅ 品牌一致性检查通过"

echo "=== 前端预提交检查全部通过 ==="

# Backend: opt-in pytest smoke (default off — full suite ~2min, CI 兜底)
case "${LINGWEN_PRECOMMIT_PYTEST:-}" in
  1|true|yes)
    cd "$(git rev-parse --show-toplevel)/novel-factory"
    pytest tests/ci/ \
      --ignore=tests/ci/test_precommit_pytest_smoke.py \
      tests/dashboard/test_api.py::TestHealthEndpoint \
      -q --timeout=30
    ;;
  last-failed)
    cd "$(git rev-parse --show-toplevel)/novel-factory"
    pytest --last-failed -q --timeout=30
    ;;
esac